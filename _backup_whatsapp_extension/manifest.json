{
  "manifest_version": 3,
  "name": "WhatsApp Number Checker",
  "version": "2.0.0",
  "description": "Bulk check which numbers are on WhatsApp. Requires WhatsApp Web login.",
  "permissions": ["tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Number Checker"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}